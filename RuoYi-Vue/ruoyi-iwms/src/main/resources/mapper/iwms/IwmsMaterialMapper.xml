<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iwms.mapper.IwmsMaterialMapper">

	<resultMap type="IwmsMaterial" id="IwmsMaterialResult">
		<id     property="materialId"     column="material_id"     />
		<result property="materialCode"   column="material_code"   />
		<result property="materialName"   column="material_name"   />
		<result property="spec"           column="spec"            />
		<result property="unit"           column="unit"            />
		<result property="category"       column="category"        />
		<result property="minStock"       column="min_stock"       />
		<result property="status"         column="status"          />
		<result property="createBy"       column="create_by"       />
		<result property="createTime"     column="create_time"     />
		<result property="updateBy"       column="update_by"       />
		<result property="updateTime"     column="update_time"     />
		<result property="remark"         column="remark"          />
	</resultMap>

	<sql id="selectIwmsMaterialVo">
        select material_id, material_code, material_name, spec, unit, category, min_stock, status, create_by, create_time, update_by, update_time, remark
		from iwms_material
    </sql>

	<select id="selectIwmsMaterialList" parameterType="IwmsMaterial" resultMap="IwmsMaterialResult">
	    <include refid="selectIwmsMaterialVo"/>
		<where>
			<if test="materialCode != null and materialCode != ''">
				AND material_code like concat('%', #{materialCode}, '%')
			</if>
			<if test="materialName != null and materialName != ''">
				AND material_name like concat('%', #{materialName}, '%')
			</if>
			<if test="spec != null and spec != ''">
				AND spec like concat('%', #{spec}, '%')
			</if>
			<if test="category != null and category != ''">
				AND category = #{category}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
	</select>

	<select id="selectIwmsMaterialById" parameterType="Long" resultMap="IwmsMaterialResult">
		<include refid="selectIwmsMaterialVo"/>
		where material_id = #{materialId}
	</select>

	<select id="selectIwmsMaterialByCode" parameterType="String" resultMap="IwmsMaterialResult">
		<include refid="selectIwmsMaterialVo"/>
		where material_code = #{materialCode} limit 1
	</select>

	<select id="checkMaterialCodeUnique" parameterType="String" resultMap="IwmsMaterialResult">
		<include refid="selectIwmsMaterialVo"/>
		 where material_code = #{materialCode} limit 1
	</select>

	<insert id="insertIwmsMaterial" parameterType="IwmsMaterial" useGeneratedKeys="true" keyProperty="materialId">
 		insert into iwms_material
 		<trim prefix="(" suffix=")" suffixOverrides=",">
 			<if test="materialCode != null and materialCode != ''">material_code,</if>
 			<if test="materialName != null and materialName != ''">material_name,</if>
 			<if test="spec != null">spec,</if>
 			<if test="unit != null and unit != ''">unit,</if>
 			<if test="category != null">category,</if>
 			<if test="minStock != null">min_stock,</if>
 			<if test="status != null">status,</if>
 			<if test="remark != null">remark,</if>
 			<if test="createBy != null">create_by,</if>
 			<if test="createTime != null">create_time,</if>
 			<if test="updateBy != null">update_by,</if>
 			<if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
 			<if test="materialCode != null and materialCode != ''">#{materialCode},</if>
 			<if test="materialName != null and materialName != ''">#{materialName},</if>
 			<if test="spec != null">#{spec},</if>
 			<if test="unit != null and unit != ''">#{unit},</if>
 			<if test="category != null">#{category},</if>
 			<if test="minStock != null">#{minStock},</if>
 			<if test="status != null">#{status},</if>
 			<if test="remark != null">#{remark},</if>
 			<if test="createBy != null">#{createBy},</if>
 			<if test="createTime != null">#{createTime},</if>
 			<if test="updateBy != null">#{updateBy},</if>
 			<if test="updateTime != null">#{updateTime},</if>
         </trim>
	</insert>

	<update id="updateIwmsMaterial" parameterType="IwmsMaterial">
 		update iwms_material
 		<set>
 			<if test="materialCode != null and materialCode != ''">material_code = #{materialCode},</if>
 			<if test="materialName != null and materialName != ''">material_name = #{materialName},</if>
 			<if test="spec != null">spec = #{spec},</if>
 			<if test="unit != null and unit != ''">unit = #{unit},</if>
 			<if test="category != null">category = #{category},</if>
 			<if test="minStock != null">min_stock = #{minStock},</if>
 			<if test="status != null">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null">update_by = #{updateBy},</if>
 			<if test="updateTime != null">update_time = #{updateTime},</if>
 		</set>
 		where material_id = #{materialId}
	</update>

	<delete id="deleteIwmsMaterialById" parameterType="Long">
 		delete from iwms_material where material_id = #{materialId}
 	</delete>

 	<delete id="deleteIwmsMaterialByIds" parameterType="Long">
 		delete from iwms_material where material_id in
 		<foreach item="materialId" collection="array" open="(" separator="," close=")">
 			#{materialId}
        </foreach>
 	</delete>

</mapper>
